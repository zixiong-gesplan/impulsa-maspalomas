---
import { ArrowRight } from '@lucide/astro';
import Title from '../components/Title.astro';
import { Link } from '@components/Link';
---

<section class="relative overflow-hidden md:pt-10 md:pb-20 p-8">
    <div
        class="container relative flex flex-col items-center text-center mx-auto"
    >
        <Title />
        <p class="max-w-[800px] text-muted-foreground md:text-xl mb-8 px-16">
            Una iniciativa para conocer los secretos de los senderos de Maspalomas y
            adentrarse en nuevas experiencias.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
            <Link
                href="/impulsa-maspalomas#senderos"
                color="amber"
            >
                Conoce las rutas
                <ArrowRight class="ml-2 h-4 w-4" />
            </Link>
        </div>

    </div>
</section>
