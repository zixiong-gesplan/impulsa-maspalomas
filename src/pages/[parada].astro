---
import type { GetStaticPaths } from 'astro';
import PathLayout from '@layouts/PathLayout.astro';
import { AudioGuide } from '@components/AudioGuide';

import { STANDS } from '@consts/STANDS';
import { FlagLink } from '@components/FlagLink';

const { parada } = Astro.params;

const stand = STANDS.find(stand => stand.id === parada);
if (!stand) return Astro.redirect('/404');
export const getStaticPaths = (() => {
    return STANDS.map(stand => ({
        params: { parada: stand.id }
    }));
}) satisfies GetStaticPaths;
---

<PathLayout id={stand.id} {...stand.path}>
    <div class="w-10/12 mx-auto mb-16">
        <AudioGuide
            {...stand}
        />
    </div>

    <div class="w-10/12 mx-auto mb-16 flex items-center justify-center">
        <div class="flex">
            <FlagLink {...stand.prev} />
            <svg
                viewBox="0 0 190 33"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="w-full"
            >
                <path
                    class="w-full"
                    d="M0.5 21.5003C0.5 21.5003 44 15.5 50 27.0003C56 38.5006 85 27.0003 125.5 7.50029C166 -11.9997 189.5 21.5003 189.5 21.5003"
                    stroke="#AFAFAF"
                    stroke-linecap="round"
                    stroke-dasharray="2 2"
                >
                </path>
            </svg>
        </div>
        <div
            class="flex flex-col items-center gap-2 text-2xl font-semibold text-gray-800 hover:text-gray-600"
        >
            <svg width="94" height="110" viewBox="0 0 56 77" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M29.5841 71.9599C28.8989 73.5959 26.5812 73.5966 25.895 71.961L4.88269 21.8772C4.32985 20.5595 5.29733 19.1039 6.72632 19.1034L48.7194 19.0902C50.1484 19.0897 51.1168 20.5447 50.5648 21.8628L29.5841 71.9599Z" fill="#FD2626" />
                <text x="23" y="45" fill="white">{stand.label}</text>
                <path d="M8 8L16.8388 16.8388" stroke="#FF0000" stroke-linecap="round" />
                <path d="M39 17L47.8388 8.16117" stroke="#FF0000" stroke-linecap="round" />
                <path d="M28 2V17.5" stroke="#FF0000" stroke-linecap="round" />
            </svg>

        </div>

        {
            !stand.next
                ? <span></span>
                : (
                        <div class="flex">
                            <svg
                                viewBox="0 0 190 33"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-full"
                            >
                                <path
                                    d="M0.5 21.5003C0.5 21.5003 44 15.5 50 27.0003C56 38.5006 85 27.0003 125.5 7.50029C166 -11.9997 189.5 21.5003 189.5 21.5003"
                                    stroke="#AFAFAF"
                                    stroke-linecap="round"
                                    stroke-dasharray="2 2"
                                >
                                </path>
                            </svg>
                            <FlagLink {...stand.next} />

                        </div>
                    )

        }

    </div>
</PathLayout>
