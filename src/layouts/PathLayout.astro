---
import Breadcrums from "@components/Breadcrums/Breadcrums.astro";
import Button from "@components/Button/Button.astro";
import Layout from "@layouts/Layout.astro";
import { Download, Share2 } from "@lucide/astro";

const { src, title, description, id } = Astro.props;
---

<Layout>
  <main
    class="flex flex-col bg-[url(/impulsa-maspalomas/background.png)] bg-cover bg-no-repeat bg-center min-h-screen"
  >
    <div class="w-10/12 mx-auto">
      <Breadcrums id={id} title={title} />

      <div class="mb-16 max-w-[700px] mx-auto text-muted-foreground">
        <h2
          class="text-2xl font-bold tracking-tighter sm:text-2xl md:text-3xl mb-4"
        >
          {title}
        </h2>
        <div class="flex">
          <!-- <button
            class="my-2 px-4 py-2 bg-amber-800 text-white rounded-lg hover:bg-amber-700 transition-colors w-full font-bold flex items-center justify-center gap-2 border-4 border-amber-800 hover:border-amber-700"
          >
            <Download />
            Descargar
          </button> -->
          <Button type="primary" size="default">
            <Download />
            Descargar
          </Button>
          <Button type="secondary" size="default">
            <Share2 />
            Compartir
          </Button>
        </div>


        <img
          src={src}
          alt={title}
          class="rounded-lg w-full mx-auto mb-4 shadow-lg"
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
          fetchpriority="high"
          sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 50vw"
        />
        <p class="">
          {description}
        </p>
      </div>
    </div>
    <div class="w-full md:w-1/2 mx-auto mb-16 flex gap-4 items-center justify-center">
      <div class="">
        <h4 class="text-2xl font-bold mb-4 text-center">
          Estadísticas del recorrido
        </h4>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-lg shadow">
            <h5 class="text-lg font-semibold">Distancia</h5>
            <p class="text-gray-600">2,3 km</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h5 class="text-lg font-semibold">Duración</h5>
            <p class="text-gray-600">2 horas</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h5 class="text-lg font-semibold">Dificultad</h5>
            <p class="text-gray-600">Fácil</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h5 class="text-lg font-semibold">Desnivel</h5>
            <p class="text-gray-600">200 m</p>
          </div>
        </div>
      </div>

      <div class="flex justify-between items-center mt-4">
        <img
          src="/impulsa-maspalomas/DUNIA_2.png"
          alt="Dunia de Balancón"
          class="w-auto h-56"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <slot />
  </main>
</Layout>
