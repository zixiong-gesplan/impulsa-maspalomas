---
import Breadcrums from '@components/Breadcrums/Breadcrums.astro';
import Button from '@components/Button/Button.astro';
import StadisticCard from '@components/StadisticCard/StadisticCard.astro';
import { ASSETS } from '@consts/ASSETS';
import Layout from '@layouts/Layout.astro';
import { Download, Share2 } from '@lucide/astro';

const { src, title, description, id, kmz, guide} = Astro.props;
---

<Layout>
    <main
        class="flex flex-col bg-[url(/impulsa-maspalomas/background.png)] bg-cover bg-no-repeat bg-center min-h-screen"
    >
        <div class="w-10/12 mx-auto">
            <Breadcrums id={id} title={title} />

            <div class="mb-16 max-w-[700px] mx-auto text-muted-foreground">
                <h2
                    class="text-2xl font-bold tracking-tighter sm:text-2xl md:text-3xl mb-4"
                >
                    {title}
                </h2>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                    <Button type="primary" size="default">
                        <a href={kmz} target="_blank" rel="noopener noreferrer"
                            class="flex sm:gap-4"
                        >
                            <Download />
                            Descargar
                        </a>
                    </Button>
                    <Button type="secondary" size="default">
                        <Share2 />
                        Compartir
                    </Button>
                </div>

                <img
                    src={src}
                    alt={title}
                    class="rounded-lg w-full mx-auto mb-4 shadow-lg"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                    fetchpriority="high"
                    sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 50vw"
                />
                <p class="">
                    {description}
                </p>
            </div>
        </div>
        <div class="w-full md:w-1/2 mx-auto mb-16 flex gap-4 items-center justify-center flex-col-reverse md:flex-row">
            <div class="">
                <h4 class="text-2xl font-bold mb-4 text-center">
                    Estadísticas del recorrido
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-2 gap-4">
                    <StadisticCard
                        src={ASSETS.LENGTH}
                        alt="Distancia"
                        value={guide.length}
                        label="Distancia"
                    />
                    <StadisticCard
                        src={ASSETS.TIME}
                        alt="Duración"
                        value={guide.time ?? '-'}
                        label="Duración"
                    />
                    <StadisticCard
                        src={ASSETS.DIFFICULTY}
                        alt="Dificultad"
                        value={guide.difficulty}
                        label="Dificultad"
                    />
                    <StadisticCard
                        src={ASSETS.MAXIMUM_FEE}
                        alt="Desnivel"
                        value={guide.maximum_fee ?? '-'}
                        label="Desnivel"
                    />
                </div>
            </div>

            <div class="flex justify-between items-center mt-4">
                <picture>
                    <source
                        srcset={ASSETS.DUNIA.DEFAULT}
                        media="(max-width: 768px)"
                    />
                    <img
                        src={ASSETS.DUNIA.POINTING}
                        alt="Dunia de Balancón"
                        class="w-auto h-56"
                        loading="lazy"
                        decoding="async"
                    />
                </picture>

            </div>
        </div>

        <slot />
    </main>
</Layout>
