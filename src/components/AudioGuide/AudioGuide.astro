---
import { Button } from '@components/Button';
import { Chip } from '@components/Chip';
import { PlayCircle, Repeat, StopCircle } from '@lucide/astro';

const { src, chip, title, audio } = Astro.props;

const words = audio.split(' ');
---

<div
    class="border border-gray-300 rounded-lg p-4 flex flex-col md:flex-row items-center justify-center h-full gap-4 bg-gray-100 shadow-md hover:shadow-lg transition-shadow duration-300 ease-in-out"
>
    <div
        class="flex items-center justify-center bg-gray-100 rounded-lg mb-4 w-1/4"
    >
        <img
            src={src}
            alt=""
            class="object-cover aspect-square rounded-lg w-full h-full"
        />
    </div>

    <div class="flex flex-col w-3/4"
      data-audio={audio}
      id="audioguide"
    >
        <div class="flex flex-col items-start text-left gap-2 mb-4 px-2">
            <Chip>{chip}</Chip>
            <h3 class="text-2xl font-semibold">{title}</h3>
            <p id="transcription" class="text-sm text-gray-500 h-36 overflow-y-scroll text-balance pr-4">
                {words.map((word: string, idx: number) => (
                    <span id={`word-${idx}`}>
                        {word}
                        {' '}
                    </span>
                ))}
            </p>
        </div>
        <div
            class="w-full"
            data-audio={audio}
            id="audio-guide"
        >
            <div class="flex gap-4 mb-4">
                <Button
                    type="primary"
                    size="small"
                    aria-label="Repetir audioguía"
                    data-action="repeat"
                >
                    <Repeat class="h-8 w-8" />
                </Button>
                <Button
                    type="primary"
                    size="small"
                    aria-label="Reproducir audioguía"
                    data-action="play"
                >
                    <PlayCircle class="h-8 w-8" />
                </Button>
                <Button
                    type="primary"
                    size="small"
                    aria-label="Detener audioguía"
                    data-action="stop"
                >
                    <StopCircle class="h-8 w-8" />
                </Button>
            </div>
        </div>

    </div>
</div>

<script type="module" is:inline>
  const { words } = document.querySelector('#audioguide').dataset;
  let utterance = null;
  let interval = null;
  let currentWordIndex = 0;
  const initialSpan = document.getElementById(`word-0`);
  const initialTop = initialSpan.offsetTop;
  const container = document.querySelector('#transcription');

  function lowlightWord(index){
    let spans = document.querySelectorAll("#transcription span");
    for(let i = 0; i< index; i++){
      if(!spans[i]){return}
      spans[i].classList.add('text-gray-300')
    }
  }
  function highlightWord(index) {
    const spans = document.querySelectorAll("#transcription span");
    spans.forEach((span, i) => {
        span.classList.toggle("font-medium", i === index);
    });
    const currentSpan = document.getElementById(`word-${index}`);
    if (currentSpan && container) {
      const spanTop = currentSpan.offsetTop;
      container.scrollTo({
        top:(spanTop - initialTop),
        behavior: 'smooth'
      });
    }
  }
 const synth = window.speechSynthesis;

  function stopAudio() {
    if (!synth.speaking) {
        return;
    }
    synth.cancel(); // Stop the speech synthesis
    clearInterval(interval)
    return;  
  }
  document.querySelector('button[data-action="stop"]').addEventListener("click", stopAudio);

  function playAudio() {
    // Check if the audio is playing
    utterance = new SpeechSynthesisUtterance();
    utterance.text = words.split(",");
    utterance.rate = 1;
    utterance.lang = 'es-ES';
    utterance.pitch = 1;
    if (synth.speaking)  {return } 
    highlightWord(currentWordIndex);
    interval = setInterval(() => {
      currentWordIndex++;
      if (currentWordIndex >= words.length) {
        clearInterval(interval);
        return;
      }
      lowlightWord(currentWordIndex)
      highlightWord(currentWordIndex);
    }, 301);
    synth.speak(utterance);

    // Return a message or perform any other action if needed
    // For example, you can return a message to indicate that the audio is playing
    // return "Audio is playing";
    return "";
  }

  document.querySelector('button[data-action="play"]').addEventListener("click", playAudio);

  function repeatAudio() {
    stopAudio(); // Stop any currently playing audio
    playAudio(); // Play the audio again
  }
  document.querySelector('button[data-action="repeat"]').addEventListener("click", repeatAudio);

</script>
