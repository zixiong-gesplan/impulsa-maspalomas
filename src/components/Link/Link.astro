---
import { cva } from 'class-variance-authority';
const link = cva('text-white border rounded-md  font-medium transition-colors flex items-center justify-center cursor-pointer', {
    variants: {
        color: {
            amber: 'bg-amber-500 hover:bg-amber-600',
            yellow: 'bg-yellow-500 hover:bg-yellow-600',
            blue: 'bg-blue-500 hover:bg-blue-600'
        },
        size: {
            default: 'text-base px-4 py-2',
            small: 'text-sm px-2 py-1'
        }
    }
});

const {
    color = 'amber',
    size = 'default',
    ...props
} = Astro.props;
---
<a
    class={link({
        color,
        size
    })}
    {...props}
>
    <slot />
</a>
