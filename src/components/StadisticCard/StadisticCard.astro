---
const { src, alt, value, label } = Astro.props;
---

<div class="bg-white p-4 rounded-lg shadow flex gap-2 flex-col lg:flex-row">
    <img src={src} alt={alt} class="w-10 h-10 mx-auto" />
    <div class="flex flex-col justify-center">
        <h5 class="text-base lg:text-lg font-semibold text-center lg:text-left">{label}</h5>
        <p class="text-gray-600 text-center lg:text-left">{value}</p>
    </div>
</div>
